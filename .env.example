# Copy to `.env` and fill in. Never commit .env.

# === Alpaca Markets ===
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# === Telegram (shared with AI_trader) ===
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# === Anthropic (news sentiment scoring) ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# === Reddit (Phase 5) ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-radar/0.1 by marsyang

# === Database ===
DATABASE_URL=sqlite:///./data/radar.db

# === Logging ===
LOG_LEVEL=INFO
LOG_DIR=./logs

# === Reports ===
REPORTS_DIR=./reports

# === AI_trader integration ===
AITRADER_DATA_DIR=/Users/marsyang/workspace/AI_trader/data
